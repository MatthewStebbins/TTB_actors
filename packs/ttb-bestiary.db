,"resist":"","damage":{"weak":"","moderate":"","severe":""},"description":[]}]},"_id":"rougarou"}
{"name":"Bayou Gremlin","type":"fatemaster","img":"","system":{"rank":{"title":"Minion","value":5},"types":"","derivedStats":{"df":"4 (9)","willpower":"3 (8)","walk":"5","height":"1","charge":"5","initiative":"2 (7)","wounds":"4"},"skills":{"gambling":{"value":1},"carouse":{"value":2},"notice":{"value":1},"homesteading":{"value":1},"longarms":{"value":2},"music":{"value":1},"evade":{"value":2},"melee":{"value":2},"deceive":{"value":2},"pickpocket":{"value":1},"track":{"value":1},"barter":{"value":1},"wilderness":{"value":1},"husbandry":{"value":1}},"attributes":{"cunning":{"value":1},"resilience":{"value":0},"intellect":{"value":-1},"grace":{"value":2},"tenacity":{"value":1},"might":{"value":-1},"speed":{"value":1},"charm":{"value":-2}},"abilities":[{"name":"Drunk and Reckless","description":"If this character has the Intoxicated Condition, it may suffer 2 damage at the start of its turn to gain one additional General AP."},{"name":"From the Hip","description":"This character uses its Grace instead of its Intellect when making Long Arm attacks."},{"name":"Df (Mask) \"Squeal!\"","description":"After this character is damaged by an enemy Close Combat attack, push this character 4 yards directly away from the attacker."}],"actions":[{"apCost":1,"name":"Banjo Bash","skill":"Melee","av":"1","avModified":"6","range":"y2","resist":"Df","damage":{"weak":"2","moderate":"2","severe":"4"},"description":["Target suffers 2/2/4 damage. If this weapon inflicts a Critical Effect, it breaks in half and ceases to function as either a weapon or a musical instrument."]},{"apCost":1,"name":"Boomstick","skill":"Long Arms","av":"4","avModified":"9","range":"z12","resist":"Df","damage":{"weak":"1","moderate":"2","severe":"3"},"description":["Target suffers 1/2/3B damage. This Attack must declare a Trigger if possible. Capacity 1, Reload 1.","- Ram Dumb Luck: When damaging, this attack inflicts double damage. This character suffers damage equal to half of the amount suffered by the target.","- Crow Whoops, Ricochet: After resolving, the closest other character within range and line of sight suffers 1 damage.","- Tome What If... More Powder?: When damaging, this attack adds +B to its Moderate and Severe damage.","- Mask \"I Got 'im!\": After succeeding, push this character 3 yards toward the target."]}]},"_id":"bayou-gremlin"}
{"name":"Bayou Boss","type":"fatemaster","img":"","system":{"rank":{"title":"Enforcer","value":8},"types":"","derivedStats":{"df":"5 (13)","willpower":"6 (14)","walk":"5","height":"2","charge":"6","initiative":"5 (13)","wounds":"9"},"skills":{"gambling":{"value":2},"centering":{"value":4},"toughness":{"value":3},"carouse":{"value":4},"notice":{"value":3},"leadership":{"value":2},"music":{"value":1},"evade":{"value":3},"melee":{"value":3},"thrownweapons":{"value":2},"deceive":{"value":3},"shotgun":{"value":3},"barter":{"value":2},"wilderness":{"value":1}},"attributes":{"cunning":{"value":3},"resilience":{"value":3},"intellect":{"value":-1},"grace":{"value":2},"tenacity":{"value":3},"might":{"value":2},"speed":{"value":2},"charm":{"value":-2}},"abilities":[{"name":"Encouragement","description":"Friendly characters within 6 yards of this character may suffer 1 damage when performing an Action to gain + to that flip."},{"name":"Gremlin Boss","description":"This character is accompanied by a number of friendly Bayou Gremlins equal to its Rank Value."},{"name":"Df (Tome) \"Delegate\"","description":"After an attack succeeds against this character, it instead affects a friendly character within 3 yards of this character."}],"actions":[{"apCost":1,"name":"Clubbin' Stick","skill":"Melee","av":"5","avModified":"13","range":"y1","resist":"Df","damage":{"weak":"2","moderate":"2","severe":"4"},"description":["Target suffers 2/2/4 damage, +1 damage if it is a Pig."]},{"apCost":1,"name":"Flintlock Boomer 1894","skill":"Shotgun","av":"5","avModified":"13","range":"z10","resist":"Df","damage":{"weak":"","moderate":"","severe":""},"description":["Target suffers 2/5b/5b damage. This weapon gains + to damage flips against characters within 3 yards, and − to damage flips against characters further than 6 yards away.","- Ram Blown Back: After damaging, if this attack dealt Moderate or Severe damage, the target is pushed 1 yard away and becomes Prone."]},{"apCost":1,"name":"\"Git Over 'ere!\"","skill":"Leadership","av":"","avModified":"","range":"","resist":"","damage":{"weak":"","moderate":"","severe":""},"description":[]}]},"_id":"bayou-boss"}
{"name":"Slop Hauler","type":"fatemaster","img":"","system":{"rank":{"title":"Minion","value":6},"types":"","derivedStats":{"df":"4 (10)","willpower":"4 (10)","walk":"5","height":"1","charge":"6","initiative":"4 (10)","wounds":"5"},"skills":{"music":{"value":1},"homesteading":{"value":2},"notice":{"value":2},"deceive":{"value":2},"wilderness":{"value":1},"melee":{"value":2},"carouse":{"value":2},"thrownweapon":{"value":3},"evade":{"value":2},"husbandry":{"value":2},"athletics":{"value":2}},"attributes":{"cunning":{"value":1},"resilience":{"value":1},"intellect":{"value":-1},"grace":{"value":2},"tenacity":{"value":2},"might":{"value":0},"speed":{"value":2},"charm":{"value":-3}},"abilities":[{"name":"One Eye on the Pigs","description":"At the start of this character's turn, if there is a Pig within 3 yards of it, this character generates one additional AP that can only be used to take a Movement General Action."},{"name":"Df (Mask) \"Squeal!\"","description":"After this character is damaged by an enemy Close Combat attack, push this character 4 yards directly away from the attacker."}],"actions":[{"apCost":1,"name":"Slop Bucket","skill":"Melee","av":"","avModified":"","range":"","resist":"","damage":{"weak":"","moderate":"","severe":""},"description":[]},{"apCost":1,"name":"Tossed Slop","skill":"Thrown Weapon","av":"5","avModified":"11","range":"z9","resist":"Df","damage":{"weak":"1","moderate":"2","severe":"3"},"description":["Target suffers 1/2/3B damage. Every character damaged by this attack gains the following Condition until it washes the slop off: *\"Covered in Slop: This character suffers − to all Social Skill duels and cannot declare Triggers. Pigs targeting this character with attacks gain + to the Attack flip.\"* Capacity 1, Reload 1.","- Mask \"Come and Get It!\": After succeeding, every Pig within p5 of the target pushes 5 yards toward the character and makes a y attack against the target, if possible."]}]},"_id":"slop-hauler"}
{"name":"Moon Shinobi","type":"fatemaster","img":"","system":{"rank":{"title":"Enforcer","value":7},"types":"","derivedStats":{"df":"6 (13)","willpower":"4 (11)","walk":"5","height":"1","charge":"6","initiative":"5 (12)","wounds":"8"},"skills":{"stealth":{"value":3},"gambling":{"value":1},"wilderness":{"value":1},"martialarts":{"value":3},"bewitch":{"value":3},"carouse":{"value":5},"culinary":{"value":2},"toughness":{"value":3},"evade":{"value":4},"pickpocket":{"value":2},"notice":{"value":3},"pugilism":{"value":3},"acrobatics":{"value":2}},"attributes":{"cunning":{"value":1},"resilience":{"value":2},"intellect":{"value":-1},"grace":{"value":2},"tenacity":{"value":2},"might":{"value":0},"speed":{"value":2},"charm":{"value":1}},"abilities":[{"name":"Drunk and Reckless","description":"If this character has the Intoxicated Condition, it may suffer 2 damage at the start of its turn to gain one additional General AP."},{"name":"Drunken Gremlin Kung Fu","description":"This character is always considered to have the Intoxicated Condition (and thus suffers - to all Willpower duels). When this character is attacked by a Close or Ranged Combat attack, the attacker counts all + modifiers as - modifiers, and vice versa."},{"name":"Numb the Pain","description":"While this character has the Intoxicated Condition, it ignores the effects of Weak and Moderate Critical Effects."}],"actions":[{"apCost":1,"name":"Tiny Green Fists of Fury","skill":"Martial Arts","av":"5","avModified":"12","range":"y1","resist":"Df","damage":{"weak":"1","moderate":"3","severe":"4"},"description":["Target suffers 1/3/4 damage. If this attack deals Severe damage, the target suffers a Weak Critical Effect.","- Ram Critical Strike: When damaging, deal 1 additional damage for each Ram in the final duel total.","- Mask Drunken Roundhouse: After succeeding, take this Action again against a different character within range."]},{"apCost":1,"name":"Have a Drink","skill":"Bewitch","av":"4","avModified":"11","range":"1","resist":"Wp","damage":{"weak":"1","moderate":"3","severe":"4"},"description":["A Living target imbibes a flask of alcohol and gains the Intoxicated Condition for 10 minutes, or the Poison +1 Condition if it is already Intoxicated.","- Crow A Bit Woozy: After succeeding, the target becomes Slow.","- Ram Liver Damage: After succeeding, the target suffers 1/3/4 damage."]}]},"_id":"moon-shinobi"}
{"name":"Piglet","type":"fatemaster","img":"","system":{"rank":{"title":"Peon","value":4},"types":"","derivedStats":{"df":"5 (9)","willpower":"3 (7)","walk":"6","height":"1","charge":"7","initiative":"4 (8)","wounds":"3"},"skills":{"track":{"value":1},"wilderness":{"value":2},"pugilism":{"value":1},"notice":{"value":1}},"attributes":{"cunning":{"value":-3},"resilience":{"value":0},"intellect":{"value":-2},"grace":{"value":0},"tenacity":{"value":1},"might":{"value":2},"speed":{"value":3},"charm":{"value":-3}},"abilities":[{"name":"Pigcharge","description":"This character may perform the (2) Charge Action as a (1) Action."},{"name":"Puny","description":"This character has -1 Wounds and may not make disengaging strikes."},{"name":"Set 'er Off","description":"At the start of this character's turn during Dramatic Time, if it is not engaged or within 2 yards of a friendly character without this Ability, this character must declare a Charge against the closest legal non-Pig target."}],"actions":[{"apCost":1,"name":"Ram","skill":"Pugilism","av":"3","avModified":"7","range":"y1","resist":"Df","damage":{"weak":"1","moderate":"2","severe":"3"},"description":["Target suffers 1/2/3 damage. When this Attack is used as part of a Charge, add +1 to the final duel total for each yard moved before the attack. This Attack must declare a Trigger if possible.","- Ram Stampede: After damaging, this character must declare a Charge against the closest legal non-Pig target which it is not engaged with. If this character is engaged, it still declares this Charge but only makes a single Attack as a result.","- Crow Eat Anything: After damaging a Living or Undead character, this character heals 1 damage.","- Tome Grab On: After damaging, the target gains the following Condition: *\"Clamped On +1: This character receives -1 Walk, -2 Charge, and suffers +1 damage at the end of her turn. The character that applied this Condition is carried along if this character moves. If the character that applied this Condition is killed, knocked unconscious, moves, or takes any Actions, end this Condition.\"*","- Mask Bowled Over: After succeeding, the target must succeed at a TN 10 Acrobatics Challenge or be knocked Prone. Then this character becomes Prone."]}]},"_id":"piglet"}
{"name":"Bayou Pig","type":"fatemaster","img":"","system":{"rank":{"title":"Minion","value":6},"types":"","derivedStats":{"df":"4 (10)","willpower":"4 (10)","walk":"5","height":"2","charge":"6","initiative":"4 (10)","wounds":"7"},"skills":{"track":{"value":2},"toughness":{"value":2},"wilderness":{"value":3},"pugilism":{"value":2},"notice":{"value":2}},"attributes":{"cunning":{"value":-2},"resilience":{"value":2},"intellect":{"value":-1},"grace":{"value":0},"tenacity":{"value":2},"might":{"value":3},"speed":{"value":2},"charm":{"value":-4}},"abilities":[{"name":"Pigcharge","description":"This character may perform the (2) Charge Action as a (1) Action."},{"name":"Set 'er Off","description":"At the start of this character's turn during Dramatic Time, if it is not engaged or within 2 yards of a friendly character without this Ability, this character must declare a Charge against the closest legal non-Pig target."},{"name":"Eat Like A Pig","description":"After killing a Living or Undead creature with a Close Combat attack, this character may immediately end its turn to heal 3 damage."}],"actions":[{"apCost":1,"name":"Tusks","skill":"Pugilism","av":"5","avModified":"11","range":"y1","resist":"Df","damage":{"weak":"2","moderate":"3","severe":"4"},"description":["Target suffers 2/3/4 damage. This Attack must declare a Trigger if possible.","- Ram Stampede: After damaging, this character must declare a Charge against the closest legal non-Pig target which it is not engaged with. If this character is engaged, it still declares this Charge but only makes a single Attack as a result.","- Crow Eat Anything: After damaging a Living or Undead character, this character heals 1 damage.","- Tome Tossed Up: After succeeding, place the target anywhere within 2 yards of this character. The target becomes Prone.","- Mask Trampling Hooves: After succeeding, the target must succeed at a TN 12 Acrobatics Challenge. On a failure, it suffers 1 damage and becomes Prone."]}]},"_id":"bayou-pig"}
{"name":"Bayou Gator","type":"fatemaster","img":"","system":{"rank":{"title":"Minion","value":6},"types":"","derivedStats":{"df":"4 (10)","willpower":"4 (10)","walk":"5","height":"2","charge":"6","initiative":"4 (10)","wounds":"7"},"skills":{"intimidate":{"value":2},"pugilism":{"value":3},"notice":{"value":2},"wilderness":{"value":3},"stealth":{"value":2},"toughness":{"value":2},"athletics":{"value":1}},"attributes":{"cunning":{"value":1},"resilience":{"value":2},"intellect":{"value":-3},"grace":{"value":-3},"tenacity":{"value":2},"might":{"value":2},"speed":{"value":2},"charm":{"value":-4}},"abilities":[{"name":"Melee Expert","description":"This character generates an additional AP on its turn, that may only be used to make a Close Combat attack."},{"name":"Aquatic","description":"This character's speed is not reduced while swimming. It can take the Charge Action while underwater."},{"name":"Ruthless","description":"This character automatically succeeds at any Willpower duel it attempts during its turn."},{"name":"Unimpeded","description":"This character ignores penalties for terrain while taking Movement Actions."}],"actions":[{"apCost":1,"name":"Fearsome Jaws","skill":"Pugilism","av":"5","avModified":"11","range":"y2","resist":"Df","damage":{"weak":"2","moderate":"3","severe":"5"},"description":["Target suffers 2/3/5 damage.","- Ram Death Roll: When damaging, this Attack gains + to its damage flip, and the target becomes Prone.","- Crow Swallow Whole: After damaging a target with a lower Height than this character, the target must discard a card or be immediately killed and eaten.","**(0) Creep**","This character (or its controller) may discard a card to move this character a distance equal to its Walk Aspect in yards."]}]},"_id":"bayou-gator"}
{"name":"Bayou Chicken","type":"fatemaster","img":"","system":{"rank":{"title":"Minion","value":6},"types":"","derivedStats":{"df":"5 (11)","willpower":"4 (10)","walk":"5","height":"2","charge":"6","initiative":"4 (10)","wounds":"7"},"skills":{"pugilism":{"value":3},"notice":{"value":2},"wilderness":{"value":2},"evade":{"value":3},"toughness":{"value":2},"athletics":{"value":1}},"attributes":{"cunning":{"value":-1},"resilience":{"value":1},"intellect":{"value":-2},"grace":{"value":1},"tenacity":{"value":2},"might":{"value":2},"speed":{"value":2},"charm":{"value":0}},"abilities":[{"name":"Rampage","description":"At the start of this character's turn, if it has 0 or fewer Wounds, it must declare a Charge against the closest legal target that it is not engaged with. If this character is engaged, it still declares this Charge but only makes a single Attack as a result. This character gains + to attack and damage flips made during this Charge Action."},{"name":"Roostercharge","description":"This character may perform the (2) Charge Action as a (1) Action."},{"name":"Unimpeded","description":"This character ignores penalties for terrain while taking Movement Actions."}],"actions":[{"apCost":1,"name":"Beak","skill":"Pugilism","av":"5","avModified":"11","range":"y2","resist":"Df","damage":{"weak":"2","moderate":"3","severe":"5"},"description":["Target suffers 2/3/5 damage. This attack must declare a Trigger if possible.","- Ram BU-GAWK!!!: After damaging, this character must declare a Charge against the closest legal target which it is not engaged with. If this character is engaged when it declares this Charge, it suffers 1 damage.","- Crow Foot Spurs: If this character is male, the target gains the Dazed Condition until the end of its next turn. If the target is already Dazed, it instead suffers +1 damage.","**(0) Delicious Egg**","If this character is female, it may discard a card to lay a fresh egg in any space adjacent to it. While within a5 of one or more fresh eggs, Bayou Chickens gain + to their Defense flips. The egg ceases to be fresh after two weeks."]},{"apCost":1,"name":"Brass Knuckles","skill":"Pugilism","av":"5","avModified":"10","range":"y1","resist":"Df","damage":{"weak":"2","moderate":"3","severe":"4"},"description":["Target suffers 2/3/4 damage. This weapon gains + to the damage flip.","- Ram Broken Nose: After damaging, the target becomes Dazed until all its damage is healed.","- Crow Aim Low: After damaging, the target becomes Slow."]},{"apCost":1,"name":"You Lookin' At Me?","skill":"Intimidate","av":"5","avModified":"10","range":"8","resist":"Wp","damage":{"weak":"","moderate":"","severe":""},"description":["If this character is capable of being Charged by the target, the target immediately declares a Charge Action against this character, even if it is engaged. Any successful attacks made as a result of this Charge suffer -- to the damage flip. After resolving these attacks, if the target was able to declare a successful Charge, it becomes Paralyzed."]},{"apCost":1,"name":"Reinforced Executioner Claw","skill":"Pugilism","av":"","avModified":"","range":"","resist":"","damage":{"weak":"","moderate":"","severe":""},"description":[]},{"apCost":1,"name":"Custom Pistol","skill":"Pistol","av":"6","avModified":"12","range":"z12 or y2","resist":"Df","damage":{"weak":"2","moderate":"4","severe":"6"},"description":["Target suffers 2/3/4 damage. If this attack was made as part of the Rapid Fire Action, increase this attack's final duel total by +2. Capacity 8, Reload 0.","- Tome Piercing Bullet: When damaging, this attack ignores Armor and Hard to Wound.","- Mask Experimental Bullet: When damaging, this attack deals 2/4/6 damage instead.","- Ram Explosive Bullet: When damaging, this attack adds +B to its Moderate and Severe damage.","- Crow Cavity Bullet: When damaging, this attack gains + to the damage flip.","**(2) Rapid Fire**","This character may discard a Twist Card to take three 1 AP attack Actions with a Ranged Combat weapon against a single target."]},{"apCost":1,"name":"Poisoned Hairpin","skill":"Melee","av":"5","avModified":"10","range":"y1","resist":"Df","damage":{"weak":"1","moderate":"1","severe":"2"},"description":["Target suffers 1/1/2 damage and gains Poison +1."]},{"apCost":1,"name":"Lure","skill":"Bewitch","av":"6","avModified":"11","range":"18 yards","resist":"Wp","damage":{"weak":"","moderate":"","severe":""},"description":["A Living target moves a number of yards equal to its Walk Aspect directly towards this character. This movement must end as close to this character as possible.","- Mask Fatal Distraction: After succeeding, a friendly character within 5 yards of this character may make a 1 AP attack against the target."]},{"apCost":1,"name":"Expensive Gift","skill":"Bewitch","av":"6","avModified":"11","range":"2 yards","resist":"Wp","damage":{"weak":"","moderate":"","severe":""},"description":["A Living target gives this character a non-weapon item held in one of its hands."]},{"apCost":1,"name":"Freezing Touch","skill":"Sorcery/Intellect","av":"","avModified":"","range":"","resist":"","damage":{"weak":"","moderate":"","severe":""},"description":[]},{"apCost":1,"name":"Lightning Bolt","skill":"Sorcery/Intellect","av":"","avModified":"","range":"","resist":"","damage":{"weak":"","moderate":"","severe":""},"description":[]},{"apCost":1,"name":"Enchant Weapon","skill":"Enchanting/Cunning","av":"","avModified":"","range":"","resist":"","damage":{"weak":"","moderate":"","severe":""},"description":[]},{"apCost":2,"name":"Elemental Bolt","skill":"Sorcery/Intellect","av":"","avModified":"","range":"","resist":"","damage":{"weak":"","moderate":"","severe":""},"description":[]},{"apCost":2,"name":"Teleport","skill":"Prestidigitation/Intellect","av":"","avModified":"","range":"","resist":"","damage":{"weak":"","moderate":"","severe":""},"description":[]},{"apCost":2,"name":"Pneumatic Drill","skill":"Pneumatic","av":"6","avModified":"11","range":"y2","resist":"Df","damage":{"weak":"4","moderate":"5","severe":"7"},"description":["Target suffers 4/5/7 damage, ignoring Armor.","- Mask Excavation: After resolving, a two yard deep, one yard wide hole is created beneath the target. The target must make a TN 10 Evade Challenge or fall into the hole and become Prone."]},{"apCost":1,"name":"Mining Pick","skill":"Heavy Melee","av":"4","avModified":"9","range":"y2","resist":"Df","damage":{"weak":"2","moderate":"3","severe":"4"},"description":["Target suffers 2/3/4 damage."]},{"apCost":2,"name":"Pneumatic Drill","skill":"Pneumatic","av":"5","avModified":"10","range":"y2","resist":"Df","damage":{"weak":"4","moderate":"5","severe":"7"},"description":["Target suffers 4/5/7 damage, ignoring Armor."]},{"apCost":1,"name":"Steel Claws","skill":"Pneumatic","av":"4","avModified":"9","range":"y1","resist":"Df","damage":{"weak":"1","moderate":"2","severe":"4"},"description":["Target suffers 1/2/4 damage.","- Tome Overheat: After resolving, destroy this character. Every character within p2 suffers 2 damage.","**(0) Swarm Together**","This character and at least one other friendly Steam Arachnid within a3 become a Steam Arachnid Swarm with a Rank Value Condition equal to the number of Steam Arachnids used to create it."]},{"apCost":1,"name":"Swarm of Steel Claws","skill":"Pneumatic","av":"","avModified":"","range":"","resist":"","damage":{"weak":"","moderate":"","severe":""},"description":[]},{"apCost":1,"name":"Circular Sawblade","skill":"Pneumatic","av":"5","avModified":"11","range":"y2","resist":"Df","damage":{"weak":"2","moderate":"3","severe":"4"},"description":["Target suffers 2/3/4 damage, ignoring Armor.","- Tome Heated Metal: After damaging, the target gains Burning +1.","- Crow Mangle: After damaging, this character chooses one piece of armor worn by the target and destroys it.","**(1) Self-Repair**","This character may use a pile of scrap within 2 yards to heal 2 damage. The pile of scrap must have roughly the same mass as a large dog, and using this Action utterly consumes it."]},{"apCost":1,"name":"Hunting Knife","skill":"Melee","av":"4","avModified":"10","range":"y1","resist":"Df","damage":{"weak":"1","moderate":"3","severe":"4"},"description":["Target suffers 1/3/4 damage."]},{"apCost":1,"name":"Quick-Draw Harnessed Hold-Out Pistol","skill":"Pistol","av":"4","avModified":"10","range":"z6","resist":"Df","damage":{"weak":"2","moderate":"3","severe":"3"},"description":["Target suffers 2/3/3 damage. This weapon may be readied as a (0) Action. The turn that this weapon is readied, it gains + to its attack flips and the target may not declare Defensive Triggers. Capacity 4, Reload 2."]},{"apCost":1,"name":"Frozen Touch","skill":"Sorcery/Intellect","av":"","avModified":"","range":"","resist":"","damage":{"weak":"","moderate":"","severe":""},"description":[]},{"apCost":1,"name":"Harpoon Gun","skill":"Archery","av":"5","avModified":"11","range":"z12","resist":"Df","damage":{"weak":"2","moderate":"4","severe":"6"},"description":["Target suffers 2/4/6 damage and becomes Slow. Capacity 1, Reload 2.","- Ram Pull and Drag: After damaging, push the target towards you a number of yards equal to your Might Aspect (minimum 1 yard).","**(2) Grim Feast**","This character may devour the corpse of a Living or Undead character of Minion rank or higher within 1 yard to gain the following Condition for 1 hour: \"Well Fed +1: This character gains +1 to her Physical Aspects, to a maximum Aspect Value of 4. The value of this Condition may not exceed +3.\" Once devoured, the corpse cannot be turned into an Undead creature."]},{"apCost":1,"name":"Jujutsu","skill":"Martial Arts","av":"5","avModified":"12","range":"y1","resist":"Df","damage":{"weak":"1","moderate":"3","severe":"4"},"description":["Target suffers 1/3/4 damage. If this attack deals Severe damage, the target suffers a Weak Critical Effect."]},{"apCost":1,"name":"Longbow","skill":"Archery","av":"6","avModified":"13","range":"z12","resist":"Df","damage":{"weak":"2","moderate":"2","severe":"4"},"description":["Target suffers 2/2/4 damage. This attack can be made without needing line of sight, but doing so imposes a - on the attack.","- Crow Barbed Arrowhead: A character wounded by this attack suffers 1 damage at the end of any turn in which it spent at least 2 AP. The Arrow can be removed with a TN 15 Doctor Challenge.","- Mask Hail of Hachinosu: When damaging, this attack gains +B to Moderate and Severe damage.","**(2) Rapid Fire**","This character may discard a Twist Card to take three 1 AP attack Actions with a Ranged Combat weapon against a single target."]},{"apCost":1,"name":"Rail Driver Limb","skill":"Pneumatic","av":"5","avModified":"10","range":"y2","resist":"Df","damage":{"weak":"2","moderate":"4","severe":"5"},"description":["Target suffers 2/4/5 damage, ignoring Armor.","- Crow Nailed Down: After damaging, the target becomes Prone and must succeed at a TN 10 Athletics Challenge when it attempts to stand up. On a failure, it does not stand up. On a success, it stands up but suffers 1 damage in the process."]},{"apCost":1,"name":"Rivet Gun","skill":"Thrown Weapons","av":"4","avModified":"9","range":"z9","resist":"Df","damage":{"weak":"2","moderate":"4","severe":"5"},"description":["Target suffers 2/4/5 damage, ignoring Armor.","**(0) Implacable Assault**","This character may discard a Twist Card to adopt the unceasing relentlessness of a machine. This grants the character a + to her attack and damage flips for the duration of her turn.","**(2) Rapid Fire**","This character may discard a Twist Card to take three 1 AP attack Actions with a Ranged Combat weapon against a single target."]},{"apCost":1,"name":"Daitō-ryū","skill":"Martial Arts","av":"5","avModified":"10","range":"y1","resist":"Df","damage":{"weak":"1","moderate":"3","severe":"4"},"description":["Target suffers 1/3/4 damage. If this attack deals Severe damage, the target suffers a Weak Critical Effect.","- Crow Atemi Strike: After succeeding, the target gains the Useless Limb Condition for an arm or leg of this character's choice until the start of this character's next turn."]},{"apCost":1,"name":"Heavy Maul","skill":"Heavy Melee","av":"5","avModified":"10","range":"y2","resist":"Df","damage":{"weak":"2","moderate":"4","severe":"6"},"description":["Target suffers 2/4/6 damage.","- Ram Hammer Time: After succeeding, the target becomes Prone.","- Crow Smashing Melons: When damaging, if the target is Prone, it suffers a Moderate Critical Effect.","**(0) Wander the Earth**","This character may push up to 2 yards in any direction."]},{"apCost":1,"name":"Daito","skill":"Melee","av":"6","avModified":"15","range":"y2","resist":"Df","damage":{"weak":"2","moderate":"3","severe":"5"},"description":["Target suffers 2/3/5 damage, ignoring Armor.","- Ram Critical Strike: When damaging the target, this attack deals +1 damage for each Ram in the final duel total.","- Crow Twist the Blade: The damage flip gains +."]},{"apCost":1,"name":"Custom Shoulder Gatling","skill":"Heavy Guns","av":"5","avModified":"14","range":"z14","resist":"Df","damage":{"weak":"","moderate":"","severe":""},"description":["Target suffers 2/3b/4bb. This action gains + to its attack flip. This weapon gives its wielder + to Intimidate duels. Capacity 8, Reload 4.","- Ram Stutter Fire: After damaging, immediately make another attack with this weapon against a different target. This extra attack may not declare Triggers."]},{"apCost":2,"name":"Run Through","skill":"Athletics","av":"","avModified":"","range":"","resist":"","damage":{"weak":"","moderate":"","severe":""},"description":[]},{"apCost":1,"name":"Double-Edged Sword","skill":"Melee","av":"","avModified":"","range":"","resist":"","damage":{"weak":"","moderate":"","severe":""},"description":[]},{"apCost":1,"name":"Shuriken","skill":"Thrown Weapons","av":"","avModified":"","range":"","resist":"","damage":{"weak":"","moderate":"","severe":""},"description":[]},{"apCost":1,"name":"Poisoned Fighting Claws","skill":"Pugilism","av":"6","avModified":"12","range":"y1","resist":"Df","damage":{"weak":"1","moderate":"3","severe":"4"},"description":["Target suffers 1/3/4 damage and gains Poison +1. These weapons gain + to the attack flip.","- Tome Overwhelm: After damaging, take this action again against the same target. This attack has -1 AV for each other time this Trigger has been declared this turn."]},{"apCost":1,"name":"Lure","skill":"Bewitch","av":"5","avModified":"11","range":"18 yards","resist":"Wp","damage":{"weak":"","moderate":"","severe":""},"description":["A Living target moves a number of yards equal to its Walk Aspect directly towards this character. This movement must end as close to this character as possible.","- Crow The Spider and the Fly: After succeeding, after the target has moved, this character may take a 1 AP Close Combat attack against the target."]},{"apCost":1,"name":"Serpent Punch","skill":"Martial Arts","av":"5","avModified":"10","range":"y1","resist":"Df","damage":{"weak":"1","moderate":"3","severe":"4"},"description":["Target suffers 1/3/4 damage. If this attack deals Severe damage, the target suffers a Weak Critical Effect.","- Crow Poisoned Chi: After damaging, the target gains Poison +1."]},{"apCost":1,"name":"Shuriken","skill":"Thrown Weapons","av":"5","avModified":"10","range":"z8","resist":"Df","damage":{"weak":"1","moderate":"2","severe":"3"},"description":["Target suffers 1/2/3 damage.","- Ram Poison Coated: After damaging, the target gains Poison +1."]},{"apCost":1,"name":"Gang Weapons","skill":"Melee","av":"4","avModified":"9","range":"y1","resist":"Df","damage":{"weak":"1","moderate":"2","severe":"3"},"description":["Target suffers 1/2/3 damage.","- Mask \"And Then He Just Strolled Away...\": After resolving, this character may move up to 3 yards in any direction."]},{"apCost":1,"name":"B&D Pocket Revolver","skill":"Pistol","av":"5","avModified":"10","range":"z6","resist":"Df","damage":{"weak":"2","moderate":"3","severe":"3"},"description":["Targe