{"name":"Marionette","type":"fatemaster","img":"","system":{"rank":{"title":"Minion","value":5},"types":"","derivedStats":{"df":"5 (10)","willpower":"5 (10)","walk":"5","height":"1","charge":"6","initiative":"2 (7)","wounds":"4"},"skills":{"evade":{"value":3},"pugilism":{"value":2}},"attributes":{"cunning":{"value":2},"resilience":{"value":0},"intellect":{"value":-3},"grace":{"value":2},"tenacity":{"value":3},"might":{"value":-1},"speed":{"value":2},"charm":{"value":1}},"abilities":[{"name":"Adorable Doll","description":"This character is indistinguishable from a normal doll when not moving."},{"name":"Flick of the Wrist","description":"This character may use its Grace instead of its Might when making Melee or Pugilism attacks."},{"name":"Trailing Strings","description":"If there is no character holding this character's strings, an Enforcer, Henchman, Master, or Fated character within 2 yards may seize them as a (0) Action. The character may release the strings at any time, but while holding them cannot use two-handed weapons or cast Spells. A character can only hold the strings of one Marionette at a time."},{"name":"Tangled Up","description":"While an enemy character is holding this character's strings, this character is Slow."},{"name":"Puppet Show","description":"While a friendly character is holding this character's strings, this character gains + to its attacks and may use the character's Skill ranks in place of its own. The character holding this character's strings may spend 1 AP to force this character to perform a (1) Action of its choice."}],"actions":[{"apCost":1,"name":"Wooden Fists","skill":"Pugilism","av":"4","avModified":"9","range":"y1","resist":"Df","damage":{"weak":"1","moderate":"2","severe":"3"},"description":["Target suffers 1/2/3 damage. This character may add the Grace Aspect of a friendly character holding its strings to its final duel total.","- Tome Made to Follow: After resolving, if it is not this character's turn, take this Action again.","**(0) Dragging Along**","This character may move up to 2 yards in any direction. Then, if there is a character holding this character's strings, it is pushed 2 yards directly toward this character."]}]},"_id":"marionette"}
