skill":"Prestidigitation/Tenacity","av":"5","avModified":"10","range":"6","resist":"Wp","damage":{"weak":"","moderate":"","severe":""},"description":["Target becomes Slow. If it is already Slow, it becomes Paralyzed. *(Note: source text truncated; effect inferred as Paralyzed.)*"]}]},"_id":"sorrow"}
