{"name":"Young Nephilim","type":"fatemaster","img":"","system":{"rank":{"title":"Minion","value":0},"types":"","derivedStats":{"df":"5 (11)","willpower":"5 (11)","walk":"5","height":"2","charge":"6","initiative":"4 (10)","wounds":"7"},"skills":{"pugilism":{"value":3},"notice":{"value":2},"track":{"value":2},"wilderness":{"value":2},"acrobatics":{"value":1},"stealth":{"value":1},"evade":{"value":3},"toughness":{"value":2},"athletics":{"value":2}},"attributes":{"cunning":{"value":2},"resilience":{"value":2},"intellect":{"value":-1},"grace":{"value":2},"tenacity":{"value":3},"might":{"value":3},"speed":{"value":2},"charm":{"value":-3}},"abilities":[{"name":"Black Blood","description":"All characters without Black Blood within 1 yard suffer 1 damage when this character suffers damage."},{"name":"Flight","description":"This character is immune to falling damage and may ignore any terrain or other characters when moving."},{"name":"Thirst for Blood","description":"This character gains the Fast Condition when a Living character within 3 yards is killed by another friendly character."},{"name":"Mature","description":"If this character kills a Living non-Nephilim character of Enforcer, Henchman, or Master rank, or a character with the Fated Characteristic, with a y attack, it may feast upon the character\u0027s remains to become a Mature Nephilim. All damage and Conditions on this character are removed."}]},"_id":"young-nephilim"}
